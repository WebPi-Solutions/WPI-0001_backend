# =====================================================================
# Plantilla de variables de entorno para el backend (NestJS) de WPI-0001.
#
# Copia este archivo a ".env" y ajusta los valores. El archivo ".env" está
# ignorado por git y se carga automáticamente mediante "dotenv".
#
# En el entorno de desarrollo de Cursor Cloud, el script de arranque
# (.cursor/environment/start.sh) genera automáticamente un ".env" con los
# valores locales de PostgreSQL y, si no se proporcionan secretos reales,
# credenciales de terceros de tipo "placeholder" que permiten arrancar la
# aplicación (las integraciones con Firebase, Dropbox, Stripe y OpenAI solo
# funcionarán cuando se configuren credenciales reales como secretos).
# =====================================================================

# --- Base de datos PostgreSQL ---
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_USERNAME=wpi_user
DATABASE_PASSWORD=wpi_password
DATABASE_NAME=wpi_dev

# --- Autenticación básica de la documentación Swagger ---
SWAGGER_USER=admin
SWAGGER_PASSWORD=admin

# --- Límites de subida de ficheros y OCR ---
# Tamaño máximo de fichero permitido en las subidas (en megabytes).
MAX_FILE_SIZE=10
# Número máximo de páginas que se procesan por OCR al registrar un gasto.
MAX_OCR_SPENT_PAGES=3

# --- Cuenta de servicio de Firebase Admin ---
# Credenciales del "service account" de Firebase utilizadas por firebase-admin.
# La clave privada debe incluirse en una sola línea, escapando los saltos de
# línea como "\n" (el código los convierte de nuevo en saltos reales).
FIREBASE_TYPE=service_account
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY_ID=your-private-key-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=000000000000000000000
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
FIREBASE_CLIENT_X509_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/your-service-account%40your-project.iam.gserviceaccount.com
FIREBASE_UNIVERSE_DOMAIN=googleapis.com

# --- Stripe (facturación y suscripciones) ---
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# --- OpenAI (procesamiento de gastos mediante IA) ---
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_ORG_ID=org-your-openai-organization-id
OPENAI_SPENTS_PROCESSING_MODEL=gpt-4o-mini

# --- Dropbox (almacenamiento de documentos) ---
DROPBOX_REFRESH_TOKEN=your-dropbox-refresh-token
DROPBOX_CLIENT_ID=your-dropbox-client-id
DROPBOX_CLIENT_SECRET=your-dropbox-client-secret
# Rutas de almacenamiento en Dropbox. Los marcadores ":enterpriseId" y
# ":spentId" se sustituyen en tiempo de ejecución por los identificadores reales.
DROPBOX_SPENT_FILE_PATH=/enterprises/:enterpriseId/spents/:spentId
DROPBOX_ENTERPRISE_FOLDER_PATH=/enterprises/:enterpriseId
DROPBOX_ENTERPRISE_LOGO_FILE_PATH=/enterprises/:enterpriseId/logo
